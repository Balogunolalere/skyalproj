# Agnes AI API Key - required for the chat functionality
# Get your API key from https://console.agnes-ai.com
AGNES_API_KEY=your_api_key_here

# Optional: Set the Agnes API base URL if using a custom endpoint
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# Paystack Test Keys (for development)
# Skyal test keys:
# PAYSTACK_SECRET_KEY=sk_test_111450c6c3fe59f097e9f3ae39843821303ff1fb
# PAYSTACK_PUBLIC_KEY=pk_test_c48c785515aa44e621cb0c144d8b7a4596321b78
PAYSTACK_SECRET_KEY=your_test_secret_key_here
PAYSTACK_PUBLIC_KEY=your_test_public_key_here

# Admin API URL (for frontend to talk to backend)
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000

# App URL (for Paystack callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000