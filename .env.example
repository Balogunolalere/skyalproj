# DeepSeek AI API Key - required for the chat functionality
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: Set the DeepSeek API base URL if using a custom endpoint
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Chat API robustness configuration (read via parseEnvInt in src/app/api/chat/route.ts)
FETCH_TIMEOUT=20000 # Timeout in ms per DeepSeek API attempt (default: 20000)
MAX_RETRIES=2 # Number of retry attempts for failed requests (default: 2)
RETRY_BASE_DELAY=1000 # Base delay in ms for retry backoff (default: 1000)
TOTAL_TIMEOUT=45000 # Hard cap in ms across ALL attempts (default: 45000; keep < maxDuration on Vercel)
RATE_LIMIT_MAX=15 # Max requests per client IP per window (default: 15)
RATE_LIMIT_WINDOW=60000 # Window in ms for rate limiting (default: 60000 = 1 minute)
# Paystack Test Keys (for development)
# Get your test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=your_test_secret_key_here
PAYSTACK_PUBLIC_KEY=your_test_public_key_here

# Admin API URL (for frontend to talk to backend)
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000

# App URL (for Paystack callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000